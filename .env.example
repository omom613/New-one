# Copy to .env.local and fill in ONE of the options below.
# (Easiest: leave both empty and paste your key in the app's 설정 screen instead.)

# Option A — personal testing: the key is bundled into the app. Don't share builds made this way.
EXPO_PUBLIC_GEMINI_API_KEY=

# Option B — run `node server/index.mjs` and point the app at it. The key stays on the server.
EXPO_PUBLIC_API_URL=

# Optional model overrides
# EXPO_PUBLIC_EMBED_MODEL=gemini-embedding-2
# EXPO_PUBLIC_TEXT_MODEL=gemini-flash-latest
